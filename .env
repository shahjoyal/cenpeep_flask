# MongoDB Connection URI — replace with your actual URI
MONGODB_URI=mongodb+srv://joyalshahdjsce:cnjnshah123@cluster0.0uk0spj.mongodb.net/cenpeep?appName=Cluster0

# Server port (default 3000)
PORT=3000

# Secret used to sign login tokens (see security.py). Generated locally for
# you below — this is fine for local dev, but for a shared/production
# deployment generate your own with `python -c "import secrets;
# print(secrets.token_hex(32))"` and DO NOT commit it or reuse this one.
JWT_SECRET=e40939c4631490e5c0f33c86ce317f82358c1657bb4f00f3e2680c469a441e02

# Set to 1 once you have HTTPS/TLS in front of this app (not needed on
# Vercel — it already terminates HTTPS for you) to redirect any stray
# HTTP request to HTTPS and send the HSTS header.
FORCE_HTTPS=0


# Encrypts sensitive session fields (inputs/results/sessionName/sourceFile)
# before they're written to MongoDB. Never sent to the browser. Generated
# locally for you below — for a shared/production deployment generate your
# own with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
DB_ENCRYPTION_KEY=cwvJLl6Muos5KebHbN3pYznvprejqxHGcFKdBzvaHE8=

# Encrypts every API response body; the browser gets this key back at
# login (see routes/auth.py) so it can decrypt responses with Web Crypto
# (see public/auth.js). This is on top of HTTPS, not instead of it — see
# the comment above RESPONSE_ENCRYPTION_KEY in security.py for what it
# actually buys you. Generate your own the same way as DB_ENCRYPTION_KEY
# above for any shared/production deployment.
RESPONSE_ENCRYPTION_KEY=KHWleFkE9Aiy5a+mPyd4kOTj2nkMo2mQJHhEMJThKr4=

# PagerDuty Events API v2 "Integration Key" (aka routing key) — from a
# PagerDuty service's "Events API v2" integration. See the deployment
# guide for how to create one. Leave blank to disable PagerDuty alerting
# entirely (pagerduty.py no-ops if this isn't set — nothing else changes).
PAGERDUTY_INTEGRATION_KEY=d0b58485766e4c09d0c428cfafe4a4e1
